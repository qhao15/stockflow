PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sales_inventory
# Hosted MySQL only: the certificate (the whole PEM text) for an encrypted connection. Empty for local.
DB_SSL_CA=
CLIENT_URL=http://localhost:5173
# The business's time zone for all dates (reports, invoices), whole hours only
TIME_ZONE=+07:00
# How many proxies sit in front of the server when hosted; check with /api/health/ip
TRUST_PROXY=1

# Auth - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Set to false on a public site: nobody can sign up, accounts come from npm run create-user
ALLOW_REGISTRATION=true

# Seller shown on PDF invoices (optional - fictional defaults are used when empty)
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_TAX_ID=
